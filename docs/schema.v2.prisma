// =============================================================================
// LINDWAY HOME — v2 TARGET SCHEMA (REVIEW COPY, NOT YET APPLIED)
//
// Assembled from CLAUDE.md §B4. Nothing reads this file: prisma.config.ts points
// at prisma/schema.prisma. Once approved it replaces that file, then
// db:reset → migrate → generate → seed → apply prisma/triggers/*.sql.
//
// 21 models. Decisions taken during review:
//   · Branding, audience and garment are ENUMS, not tables (D25). Their display
//     data lives in src/static/taxonomy.ts. Adding a value costs a migration and
//     a deploy — accepted in exchange for three tables and three admin screens.
//   · Guest → Order, Cart → OrderItem (D17). The old names described neither
//     table; the real shopping cart lives in localStorage and never reaches the
//     database.
//   · No Discount tables (D22). Discounting is Product.discount →
//     discountedPrice, plus the two v1 config groups for a store-wide promo and
//     the member rate. Targeted or scheduled campaigns are out of scope.
//   · Member stays: "is this person a member now" (revocable), while
//     Order.isMember is "was this order priced as a member" (frozen).
//   · OrderItem snapshots unitPrice and lineTotal so an order stays explainable
//     after the product's price changes.
//   · Order gains a real status plus a tracking number (D23) — the storefront
//     already promises buyers a tracking number.
//   · Product.stock is maintained by a database trigger, not application code
//     (D24), because it is the number that gates overselling.
//
// A field audit removed columns that produced nothing (D21): `code` on the three
// taxonomy tables, SizeGuide.isActive, SizeGuideRow.order,
// Product.productionNotes, Member.joinedAt.
// =============================================================================

generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  compilerBuild = "fast"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ACCESS
// =============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  password  String // bcrypt, 12 rounds
  role      Role     @default(ADMIN)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handledInquiries ContactInquiry[] // F-47
  articles         Article[] // F-42

  @@map("users")
}

// =============================================================================
// SIZING  (§B4.2)
// Body measurements live here and are shared across products. PACKAGE dimensions
// do NOT — they live on ProductVariant, because packing belongs to the individual
// product while the pattern belongs to the guide (D6).
// =============================================================================

model Size {
  id        String   @id @default(cuid())
  code      String   @unique // XS, S, M … MUST match a package_dimensions config key
  label     String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants  ProductVariant[]
  guideRows SizeGuideRow[]

  @@map("sizes")
}

model SizeGuide {
  id          String    @id @default(cuid())
  order       Int       @default(0)
  // publishedAt IS the on/off switch — null means draft. No isActive alongside it,
  // or "inactive but published" would have no defined meaning.
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rows         SizeGuideRow[]
  translations SizeGuideTranslation[]
  products     Product[]

  @@index([publishedAt])
  @@map("size_guides")
}

model SizeGuideRow {
  id           String @id @default(cuid())
  sizeGuideId  String
  sizeId       String
  measurements Json // { length: 98, waist: 62, bottom_width: 140 } — keys are stable ids

  // No `order` column: rows are ordered by `size.order`. A second ordering source
  // could contradict the first.
  sizeGuide SizeGuide @relation(fields: [sizeGuideId], references: [id], onDelete: Cascade)
  size      Size      @relation(fields: [sizeId], references: [id])

  @@unique([sizeGuideId, sizeId])
  @@map("size_guide_rows")
}

model SizeGuideTranslation {
  id              String  @id @default(cuid())
  sizeGuideId     String
  locale          Locale
  title           String // no title column on SizeGuide — it lives only here
  description     String?
  parameterLabels Json? // { length: "Panjang", waist: "Lingkar Pinggang" }

  sizeGuide SizeGuide @relation(fields: [sizeGuideId], references: [id], onDelete: Cascade)

  @@unique([sizeGuideId, locale])
  @@map("size_guide_translations")
}

// =============================================================================
// CATALOG  (§B4.3)
// Product carries no name/description/notes/category/sizes any more: name and
// content moved to ProductTranslation, category became three relations, sizes
// became ProductVariant.
// =============================================================================

model Product {
  id   String @id @default(cuid())
  sku  String @unique // also the image folder name
  slug String @unique // public URL, single locale (D4)

  // Taxonomy is three enums, not three tables (D25). Display data — label, slug,
  // description, hero image, menu order — lives in src/static/taxonomy.ts.
  branding    BrandingType // required (D5)
  garment     GarmentType? // single
  audiences   AudienceType[] // many, so a product can be unisex
  sizeGuideId String?

  // The only discount mechanism (D22). `discountedPrice` is stored, not derived at
  // read time, so listings can sort and filter on the price a buyer actually pays.
  // A store-wide promo and the member rate stay in ConfigParameter, as in v1.
  price           Decimal @db.Decimal(12, 2)
  discount        Int     @default(0)
  discountedPrice Decimal @db.Decimal(12, 2)

  images Json[] // file nodes

  // Maintained by the product_variant_stock_sync trigger (D24). Application code
  // must NOT write this column — it would be overwritten on the next variant change.
  stock Int @default(0)

  releasedAt     DateTime? // drives New Arrivals (F-33)
  soldCount      Int       @default(0) // += on order verification
  bestSellerRank Int? // manual override (F-34)

  isPreOrder Boolean @default(false)
  isFavorite Boolean @default(false) // admin-featured, NOT the wishlist (D11)
  isActive   Boolean @default(true) // also the soft-delete flag once a product has orders
  // No productionNotes: v1 kept the "made-to-order, allow 21-25 days" line here,
  // untranslatable. That text is now ProductTranslation.notes with a global default (D9).

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sizeGuide    SizeGuide?           @relation(fields: [sizeGuideId], references: [id])
  variants     ProductVariant[]
  translations ProductTranslation[]
  orderItems   OrderItem[]

  @@index([branding])
  @@index([garment])
  @@index([releasedAt])
  @@index([bestSellerRank, soldCount]) // Best Sellers sorts by rank then soldCount
  @@index([isActive, isFavorite])
  @@index([audiences], type: Gin) // array containment: "products for Women"
  @@map("products")
}

model ProductVariant {
  id                String   @id @default(cuid())
  productId         String
  sizeId            String
  quantity          Int      @default(0)
  packageDimensions Json? // { weight_g, length_cm, width_cm, height_cm } — else config default (§B6.2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size    Size    @relation(fields: [sizeId], references: [id])

  @@unique([productId, sizeId])
  @@map("product_variants")
}

model ProductTranslation {
  id        String @id @default(cuid())
  productId String
  locale    Locale

  name              String
  description       Json? // Tiptap
  notes             Json? // Tiptap — falls back to config product_defaults (D9)
  fabricInformation Json? // Tiptap — falls back to config
  shippingDelivery  Json? // Tiptap — falls back to config
  returnPolicy      Json? // Tiptap — falls back to config

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Search uses `contains`; a btree index does not help it. Add a pg_trgm GIN
  // index later if search gets slow.
  @@unique([productId, locale])
  @@map("product_translations")
}

// =============================================================================
// ORDERS  (was Guest / Cart)
// The checkout token and the order transaction depend on these two. Renaming is
// safe under D8 because D8 protects behaviour, not identifiers: hashItems, the
// 15-minute window, the signing payload and the transaction order are unchanged.
// =============================================================================

model Order {
  id             String @id @default(cuid())
  // Buyer details are a SNAPSHOT of where this order shipped, deliberately not
  // normalised onto Member — the same buyer can ship somewhere else next time.
  email          String
  fullname       String
  whatsappNumber String
  address        String
  postalCode     Int

  memberId String? // set when the buyer was a registered member at order time
  isMember Boolean @default(false) // frozen: this order was priced as a member

  shippingCost   Decimal @db.Decimal(12, 2)
  purchased      Decimal @db.Decimal(12, 2) // subtotal after discounts
  totalPurchased Decimal @db.Decimal(12, 2) // grand total, incl. tax and shipping
  totalItemsSold Int

  // `status` is the operational lifecycle an admin drives. `isPurchased` stays
  // beside it because it is what triggers the stock + soldCount transaction, and
  // moving that would touch the frozen zone (D23).
  status         OrderStatus @default(AWAITING_PAYMENT)
  isPurchased    Boolean     @default(false)
  trackingNumber String? // the storefront promises buyers one
  cancelledAt    DateTime?

  paymentMethod PaymentMethod @default(BANK_TRANSFER)
  receiptImage  Json
  instagram     String?
  reference     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member Member?     @relation(fields: [memberId], references: [id])
  items  OrderItem[]

  @@index([email]) // member lookup by email runs on every checkout
  @@index([status])
  @@index([isPurchased])
  @@index([memberId])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String @id @default(cuid())
  orderId      String
  productId    String
  quantity     Int
  selectedSize String // String, not a FK — feeds hashItems (productId:size:quantity)

  // Price snapshot. The product's price can change after the order; without this
  // the line could not be explained afterwards.
  unitPrice Decimal @db.Decimal(12, 2) // discountedPrice at order time
  lineTotal Decimal @db.Decimal(12, 2) // unitPrice * quantity

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// =============================================================================
// MEMBERS
// The member rate itself is a ConfigParameter (`member_discount`, `member_type`),
// as in v1. This table exists so membership can be revoked without rewriting the
// order history that Order.isMember records (D19).
// =============================================================================

model Member {
  id        String   @id @default(cuid())
  email     String   @unique // upserted on membership activation (§B6.4)
  fullname  String?
  isActive  Boolean  @default(true) // false = revoked, without touching order history
  createdAt DateTime @default(now()) // this IS the join date — no separate joinedAt
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("members")
}

// =============================================================================
// CONTENT  (§B4.5)
// =============================================================================

model ArticleCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles     Article[]
  translations ArticleCategoryTranslation[]

  @@map("article_categories")
}

model ArticleCategoryTranslation {
  id          String  @id @default(cuid())
  categoryId  String
  locale      Locale
  name        String
  description String?

  category ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@map("article_category_translations")
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  categoryId  String
  authorId    String? // nullable so deleting an admin does not delete their articles
  image       Json // file node — same resolveFiles pipeline as product images
  imageAlt    String?
  featured    Boolean   @default(false)
  publishedAt DateTime? // null = draft
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category     ArticleCategory      @relation(fields: [categoryId], references: [id])
  author       User?                @relation(fields: [authorId], references: [id])
  translations ArticleTranslation[]

  @@index([categoryId])
  @@index([publishedAt])
  @@index([featured])
  @@map("articles")
}

model ArticleTranslation {
  id        String  @id @default(cuid())
  articleId String
  locale    Locale
  title     String
  excerpt   String?
  content   Json // Tiptap

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@map("article_translations")
}

model Faq {
  id        String   @id @default(cuid())
  topic     String // groups FAQs so one component serves several pages
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations FaqTranslation[]

  @@index([topic])
  @@map("faqs")
}

model FaqTranslation {
  id       String @id @default(cuid())
  faqId    String
  locale   Locale
  question String
  answer   Json // Tiptap — answers routinely need lists and links

  faq Faq @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, locale])
  @@map("faq_translations")
}

model ContactInquiry {
  id          String        @id @default(cuid())
  fullname    String
  email       String
  phone       String?
  inquiryType InquiryType
  otherDetail String? // only when inquiryType = OTHER
  message     String
  status      InquiryStatus @default(NEW)

  // What the admin actually did. Without it, HANDLED records that an inquiry was
  // closed but not how, which is useless a month later.
  handlingNote String?
  handledAt    DateTime?
  handledById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handledBy User? @relation(fields: [handledById], references: [id])

  @@index([status])
  @@index([inquiryType])
  @@index([createdAt])
  @@map("contact_inquiries")
}

// =============================================================================
// SETTINGS
// ConfigParameter holds singleton settings only. Anything with relations,
// targeting, dates or status is a table instead (D12).
// =============================================================================

model ConfigParameterGroup {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "shipping", "tax", "package_dimensions"
  label       String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  configs ConfigParameter[]

  @@map("config_parameter_groups")
}

model ConfigParameter {
  id          String        @id @default(cuid())
  key         String        @unique // globally unique, not per-group
  label       String
  description String
  value       Json // public-facing values are shaped { en, id } (§B3.1)
  type        ParameterType // drives admin form rendering
  validation  Json? // only `options` is actually read today
  order       Int           @default(0)
  isActive    Boolean       @default(true)

  groupId String
  group   ConfigParameterGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("config_parameters")
}

model Location {
  id           String  @id @default(cuid())
  code         String  @unique
  province     String
  district     String
  sub_district String  @map("sub_district")
  village      String
  approx_lat   Decimal @map("approx_lat")
  approx_long  Decimal @map("approx_long")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([province])
  @@index([district])
  @@index([sub_district])
  @@index([village])
  @@map("locations")
}

// =============================================================================
// ENUMS
// Deleted relative to v1 and to earlier drafts:
//   Categories                      → the three taxonomy tables
//   PromotionScope, MemberScope     → the Discount tables they belonged to
//   DiscountKind                    → same
// DiscountType stays: it is the shape of the `tax_type`, `promo_type` and
// `member_type` config values, exactly as in v1.
// =============================================================================

enum Locale {
  EN
  ID
}

// Taxonomy (D25). Display data lives in src/static/taxonomy.ts — label, slug,
// description, hero image and menu order. Adding a value here means a migration
// plus a deploy, which is the trade accepted for dropping three tables and three
// admin CRUD screens.
enum BrandingType {
  MY_LINDWAY
  SIMPLY_LINDWAY
  LURE_BY_LINDWAY
  STUDIO_BY_LINDWAY
  LINDWAY_AWP
}

enum AudienceType {
  WOMEN
  MEN
  KIDS
}

enum GarmentType {
  DRESSES
  TOPS
  SKIRTS
}

enum Role {
  SUPER_ADMIN
  ADMIN
}

enum PaymentMethod {
  BANK_TRANSFER
  QRIS
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  SHIPPED
  COMPLETED
  CANCELLED
}

enum InquiryType {
  PRODUCT_INQUIRY
  ORDER_SUPPORT
  CUSTOM_ORDER
  WHOLESALE_B2B
  PARTNERSHIP
  OTHER
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  HANDLED
  ARCHIVED
}

enum ParameterType {
  TEXT
  NUMBER
  DECIMAL
  BOOLEAN
  SELECT
  MULTI_SELECT
  IMAGE
  IMAGES
  VIDEO
  VIDEOS
  JSON
  TEXTAREA
  COLOR
  DATE
  DATETIME
}
