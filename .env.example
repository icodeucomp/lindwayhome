# Copy to .env on the server. Used by docker-compose.yml.

# ── Database (compose builds DATABASE_URL from these) ──
POSTGRES_USER=lindway
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lindway

# Public site URL — inlined into the client bundle at BUILD time, so changing it needs a rebuild.
NEXT_PUBLIC_BASE_URL=https://example.com

# Signing secrets: long random strings (openssl rand -hex 32). The app refuses to start without them.
JWT_SECRET=
CHECKOUT_TOKEN_SECRET=
CRON_SECRET=

RESEND_API_KEY=
RESEND_EMAIL_FROM=
CONTACT_INBOX_EMAIL=

# Paxel: leave PAXEL_API_KEY empty to stay in mock mode.
PAXEL_BASE_URL=
PAXEL_API_KEY=
PAXEL_API_SECRET=
PAXEL_MODE=
PAXEL_TIMEOUT_MS=

# Xendit: leave XENDIT_SECRET_KEY empty to stay in mock mode.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_MODE=
XENDIT_TIMEOUT_MS=

# Set to true for ONE start on a fresh database to load seed data, then remove.
# Where uploaded images live on the host. Empty = a Docker named volume (fine for local use).
# On the server set /opt/lindway/uploads and give it to uid 1500, the user the container runs as:
#   useradd --system -u 1500 -U --no-create-home --shell /usr/sbin/nologin lindway-app
#   mkdir -p /opt/lindway/uploads && chown 1500:1500 /opt/lindway/uploads
UPLOADS_HOST_PATH=

SEED_ON_START=
