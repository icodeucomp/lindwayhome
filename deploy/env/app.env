# Template for /opt/lindway/env/app.env on the server (chmod 600, owned by root). Never put real
# values in this file in git. One file serves BOTH sites (lindwayhome.com and beta.lindwayhome.com):
# they share the database, secrets and the uploads volume. deploy.sh copies it into every release as `.env`
# and adds NEXT_PUBLIC_BASE_URL for the site being deployed, so do not set that one here.

# ── Database (compose builds DATABASE_URL from these) ──
POSTGRES_USER=lindway
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lindway

# Signing secrets: long random strings (openssl rand -hex 32). The app refuses to start without them.
# Shared on purpose: both sites read the same database, so a login or checkout token issued by one
# must verify on the other.
JWT_SECRET=
CHECKOUT_TOKEN_SECRET=
CRON_SECRET=

RESEND_API_KEY=
RESEND_EMAIL_FROM=
CONTACT_INBOX_EMAIL=

# Paxel: leave PAXEL_API_KEY empty to stay in mock mode.
PAXEL_BASE_URL=
PAXEL_API_KEY=
PAXEL_API_SECRET=
PAXEL_MODE=
PAXEL_TIMEOUT_MS=

# Xendit: leave XENDIT_SECRET_KEY empty to stay in mock mode.
# The invoice callback in the Xendit dashboard must point at https://lindwayhome.com (main).
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_MODE=
XENDIT_TIMEOUT_MS=

# Set to true for ONE start of main on a fresh database to load seed data, then remove.
# Beta never seeds or migrates (see docker-compose.beta.yml).
SEED_ON_START=
